{
  "config_id": "standard_aed",
  "name": "标准AED急救流程",
  "steps": [
    {
      "step_id": "confirm_scene",
      "name": "确认现场安全",
      "order": 1,
      "allowed_time": 10,
      "error_consequence": {"patient_damage": 5, "message": "未确认现场安全可能危及自身"},
      "state_changes": {}
    },
    {
      "step_id": "check_consciousness",
      "name": "判断意识",
      "order": 2,
      "allowed_time": 10,
      "error_consequence": {"patient_damage": 10, "message": "应立即判断病人意识状态"},
      "state_changes": {}
    },
    {
      "step_id": "call_120",
      "name": "拨打120",
      "order": 3,
      "allowed_time": 15,
      "error_consequence": {"patient_damage": 5, "message": "应尽快拨打急救电话"},
      "state_changes": {"called_120": true}
    },
    {
      "step_id": "check_breathing",
      "name": "检查呼吸",
      "order": 4,
      "allowed_time": 10,
      "error_consequence": {"patient_damage": 10, "message": "必须确认呼吸状态"},
      "state_changes": {}
    },
    {
      "step_id": "start_cpr",
      "name": "开始CPR",
      "order": 5,
      "allowed_time": 30,
      "error_consequence": {"patient_damage": 20, "message": "CPR是心脏骤停的关键措施"},
      "state_changes": {"started_cpr": true}
    },
    {
      "step_id": "find_aed",
      "name": "寻找AED",
      "order": 6,
      "allowed_time": 60,
      "error_consequence": {"patient_damage": 15, "message": "AED对心脏骤停至关重要"},
      "state_changes": {"found_aed": true}
    },
    {
      "step_id": "use_aed",
      "name": "使用AED",
      "order": 7,
      "allowed_time": 30,
      "error_consequence": {"patient_damage": 25, "message": "正确使用AED可以挽救生命"},
      "state_changes": {"used_aed": true}
    },
    {
      "step_id": "continue_cpr",
      "name": "继续CPR等待救援",
      "order": 8,
      "allowed_time": 0,
      "error_consequence": {},
      "state_changes": {}
    }
  ],
  "success_condition": {
    "type": "and",
    "conditions": [
      {"type": "flag_set", "key": "started_cpr"},
      {"type": "flag_set", "key": "used_aed"},
      {"type": "var_compare", "key": "time_pressure", "operator": "lt", "value": 50}
    ]
  },
  "failure_condition": {
    "type": "or",
    "conditions": [
      {"type": "var_compare", "key": "time_pressure", "operator": "gte", "value": 80},
      {"type": "var_compare", "key": "confidence", "operator": "lt", "value": 20}
    ]
  },
  "patient_rules": {
    "initial_state": {
      "condition_score": 30,
      "heart_rate": 0,
      "breathing": false,
      "consciousness": "unconscious"
    },
    "decay_rate": 2.0,
    "cpr_recovery": 5.0,
    "aed_recovery": 25.0
  }
}
